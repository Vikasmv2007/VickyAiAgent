# Gemini API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Telegram Bot (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your personal Telegram numeric Chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Tavily Web Search API Key (free tier: https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# Frontend URL for CORS and OAuth redirect after login
FRONTEND_URL=http://localhost:3000

# SQLite database file path
SQLITE_DB_PATH=vicky.db
